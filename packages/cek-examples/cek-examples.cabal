cabal-version: 3.0
name: cek-examples
version: 0.1.0.0
synopsis: Showcase mini-interpreters for CEK abstract machines
description:
  Showcase mini-interpreters (Scheme, Prolog/Mercury, 1ML) demonstrating
  automatic Generic1 dissection, O(1) continuation capture, and MergeMorph3 sealing.
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
build-type: Simple
tested-with: GHC == 9.14.1

library
  exposed-modules:
    Cek.Examples.Scheme,
    Cek.Examples.Mercury,
    Cek.Examples.OneML
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    ghc-prim,
    primitive >= 0.9,
    cek-core,
    cek-pykinos,
    pykinos-core

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded
  build-depends:
    base >= 4.18 && < 5,
    cek-core,
    cek-pykinos,
    pykinos-core,
    cek-examples,
    primitive >= 0.9,
    hspec >= 2.10 && < 2.12
